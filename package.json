{
  "name": "ek-aiot-3d-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "Experimental snapshot-first 3D editor package workspace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rookielzy/ek-aiot-3d-editor.git"
  },
  "bugs": {
    "url": "https://github.com/rookielzy/ek-aiot-3d-editor/issues"
  },
  "homepage": "https://github.com/rookielzy/ek-aiot-3d-editor#readme",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "changeset": "changeset",
    "dev:demo:react": "pnpm --filter @ek-aiot/react-proof-loop dev",
    "dev:demo:vue": "pnpm --filter @ek-aiot/vue-proof-loop dev",
    "release:publish": "pnpm release:verify && changeset publish",
    "release:status": "changeset status --verbose",
    "release:verify": "pnpm build && pnpm typecheck && pnpm test && pnpm test:browser && node scripts/verify-release.mjs",
    "release:version": "changeset version",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:demo:react": "vitest run packages/react/test/react-proof-loop.integration.test.tsx",
    "test:demo:vue": "vitest run packages/vue/test/vue-proof-loop.integration.test.ts",
    "typecheck": "pnpm --filter @ek-aiot/3d-editor-core build && pnpm -r --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
