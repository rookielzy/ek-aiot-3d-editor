{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "ignoreDeprecations": "6.0",
    "types": ["vitest/globals", "vue"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/**/*.test.ts", "test/**/*.ts"],
  "references": [{ "path": "../core" }]
}
