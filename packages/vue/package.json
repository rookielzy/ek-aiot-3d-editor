{
  "name": "@ek-aiot/3d-editor-vue",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "vue-tsc -p tsconfig.json && vite build",
    "typecheck": "pnpm --filter @ek-aiot/3d-editor-core build && vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/vue"
  },
  "dependencies": {
    "@ek-aiot/3d-editor-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.2"
  }
}
