    "test": "vitest run --root ../.. packages/react"
  },
  "dependencies": {
    "@ek-aiot/3d-editor-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
