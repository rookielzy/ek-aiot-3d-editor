{
  "name": "@ek-aiot/3d-editor-react",
  "version": "0.2.0",
  "description": "React hooks, viewport, inspector, and workbench shell for the EK AIoT 3D editor core.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/index.css"
  ],
  "license": "MIT",
  "keywords": [
    "3d",
    "editor",
    "react",
    "threejs",
    "aiot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rookielzy/ek-aiot-3d-editor.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/rookielzy/ek-aiot-3d-editor/issues"
  },
  "homepage": "https://github.com/rookielzy/ek-aiot-3d-editor#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist ../../node_modules/.cache/ek-aiot/react.tsbuildinfo && tsc -p tsconfig.json --emitDeclarationOnly --tsBuildInfoFile ../../node_modules/.cache/ek-aiot/react.tsbuildinfo && vite build --emptyOutDir false && node ../../scripts/clean-dts-css-imports.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/react"
  },
  "dependencies": {
    "@ek-aiot/3d-editor-core": "workspace:^0.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
